# ==============================================================================
# BrayanCode Agent - Variables de Entorno de Ejemplo
# ==============================================================================
# Instrucciones:
# 1. Copia este archivo y renómbralo como '.env' en la raíz del proyecto.
# 2. Configura tu API Key y la URL base del proveedor LLM que vayas a utilizar.
# ==============================================================================

# Clave de API del modelo (Requerido)
# Ejemplos: Tu clave de Moonshot/Kimi (sk-...), OpenAI (sk-proj-...), etc.
API_KEY=tu_api_key_aqui

# URL Base del Endpoint compatible con la API de OpenAI
# - Moonshot / Kimi Coding API: https://api.kimi.ai/coding/v1
# - OpenAI oficial: https://api.openai.com/v1
# - Ollama local: http://localhost:11434/v1
# - DeepSeek: https://api.deepseek.com/v1
BASE_URL=https://api.kimi.ai/coding/v1

# Identificador del Modelo a invocar
# - Kimi: kimi-for-coding
# - OpenAI: gpt-4o, gpt-4o-mini
# - Ollama: qwen2.5-coder:7b
MODEL=kimi-for-coding
